{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CircuitAgent Netlist Specification",
  "type": "object",
  "required": ["connections"],
  "properties": {
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["net", "points"],
        "properties": {
          "net": {
            "type": "string",
            "description": "Net name (e.g. /GND, /+3.3V, /SWCLK)"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]+(\\.[A-Za-z0-9_]+)?$"
            },
            "description": "List of component pin references (e.g. ['U1.1', 'C1.1'])"
          }
        }
      }
    }
  }
}
